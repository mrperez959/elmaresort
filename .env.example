# Calendarios de Airbnb/Vrbo, precios, tarifas, descuentos, huespedes,
# mascotas, impuestos y resenas se configuran en /admin (base de datos).

# ---------- Square ----------
# developer.squareup.com -> Applications -> tu app -> Credentials
# Usa primero las credenciales de Sandbox.
SQUARE_ACCESS_TOKEN=
# sandbox | production
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# developer.squareup.com -> tu app -> Locations
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# ---------- Base de datos (Postgres) ----------
# En Vercel: Storage -> Create Database -> Neon. Se llena sola al conectarla.
DATABASE_URL=postgres://usuario:clave@host:5432/elmaresort

# ---------- Seguridad ----------
# Cadena aleatoria de 32+ caracteres. Genera una con:  openssl rand -base64 48
SESSION_SECRET=
# Contrasena del panel /admin (12+ caracteres)
ADMIN_PASSWORD=

# ---------- Sitio ----------
NEXT_PUBLIC_PROPERTY_NAME=Elma Resort
NEXT_PUBLIC_PROPERTY_TAGLINE=Waterfront home with a private dock, hot tub and game room. Book direct and skip the platform fees.
NEXT_PUBLIC_PROPERTY_LOCATION=Tampa, Florida
