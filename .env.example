# Calendarios de Airbnb/Vrbo, precios, tarifas, descuentos, huespedes,
# mascotas, impuestos y resenas se configuran en /admin (base de datos).

# ---------- Square ----------
# developer.squareup.com -> Applications -> tu app -> Credentials
# Usa primero las credenciales de Sandbox.
SQUARE_ACCESS_TOKEN=
# sandbox | production
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# developer.squareup.com -> tu app -> Locations
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# ---------- Base de datos (Postgres) ----------
# En Vercel: Storage -> Create Database -> Neon. Se llena sola al conectarla.
DATABASE_URL=postgres://usuario:clave@host:5432/elmaresort

# ---------- Seguridad ----------
# Cadena aleatoria de 32+ caracteres. Genera una con:  openssl rand -base64 48
SESSION_SECRET=
# Contrasena del panel /admin (12+ caracteres)
ADMIN_PASSWORD=

# ---------- Email (codigos de verificacion y confirmaciones) ----------
# Gmail: activa la verificacion en 2 pasos y crea una "contrasena de aplicacion"
# en myaccount.google.com/apppasswords. Luego:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
MAIL_FROM="Elma Resort <tucorreo@gmail.com>"
# Tu email: recibe un aviso por cada reserva directa
ADMIN_EMAIL=
# "on" = entrar a /admin pide tambien un codigo enviado a ADMIN_EMAIL.
# Activalo solo cuando "Email" este en verde en /admin -> Connections.
ADMIN_2FA=

# ---------- Tareas automaticas ----------
# Cualquier texto largo al azar. Vercel lo usa para llamar la tarea diaria
# (emails de llegada, de agradecimiento y "tus fechas siguen libres").
CRON_SECRET=

# ---------- Apple Pay (opcional) ----------
# Contenido del archivo que Square te da al registrar tu dominio para Apple Pay.
APPLE_PAY_DOMAIN_ASSOCIATION=

# ---------- Sitio ----------
NEXT_PUBLIC_PROPERTY_NAME=Elma Resort
NEXT_PUBLIC_PROPERTY_TAGLINE=Waterfront home with a private dock, hot tub and game room. Book direct and skip the platform fees.
NEXT_PUBLIC_PROPERTY_TAGLINE_ES=Casa frente al agua con muelle privado, spa y sala de juegos. Reserva directo y ahorrate las comisiones.
NEXT_PUBLIC_PROPERTY_LOCATION=Tampa, Florida
