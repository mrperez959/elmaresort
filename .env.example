# ---------- Hospitable ----------
# my.hospitable.com -> Apps -> API access -> Access tokens (read + write)
HOSPITABLE_API_PAT=
# UUID de la propiedad en Hospitable (ver README para obtenerlo)
HOSPITABLE_PROPERTY_ID=

# ---------- Square ----------
# developer.squareup.com -> Applications -> tu app -> Credentials
# Usa primero las credenciales de Sandbox.
SQUARE_ACCESS_TOKEN=
# sandbox | production  (debe coincidir con el de abajo)
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# developer.squareup.com -> tu app -> Locations
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# ---------- Precios ----------
# Tarifa de limpieza por estancia, en dolares
CLEANING_FEE_USD=120
# Impuesto TOTAL que cobras al huesped, en porcentaje (sales tax de Florida
# + surtax del condado + Tourist Development Tax). CONFIRMALO con el Florida
# Department of Revenue y el Hillsborough County Tax Collector antes de usar.
TAX_RATE_PERCENT=
# Maximo de huespedes (adultos + ninos; los bebes no cuentan)
MAX_GUESTS=6
# Estancia maxima que se puede reservar por la web
MAX_NIGHTS=60

# ---------- Sitio ----------
NEXT_PUBLIC_PROPERTY_NAME=Elma Resort
NEXT_PUBLIC_PROPERTY_TAGLINE=Waterfront home with a private dock, hot tub and game room. Book direct and skip the platform fees.
NEXT_PUBLIC_PROPERTY_LOCATION=Tampa, Florida
NEXT_PUBLIC_MAX_GUESTS=6
